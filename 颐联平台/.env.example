# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除。
# QQ 邮箱需要在「设置 → 账户」里开启 SMTP 服务,并使用授权码(不是登录密码)。
MAIL_SERVER=smtp.qq.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=你的邮箱@qq.com
MAIL_PASSWORD=你的授权码
MAIL_DEFAULT_SENDER=你的邮箱@qq.com

# 网站管理员邮箱(可多个,逗号分隔)
# 主管:全部权限,包括删除账号;副管:查看用户、重置用户,不能删除
ADMIN_PRIMARY_EMAILS=你的邮箱@qq.com
ADMIN_SECONDARY_EMAILS=
